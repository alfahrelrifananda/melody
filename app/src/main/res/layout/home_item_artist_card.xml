<?xml version="1.0" encoding="utf-8"?>
<!--
  home_item_artist_card.xml
  A circular avatar card shown in the horizontal artists strip.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="100dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:layout_marginHorizontal="6dp"
    android:clickable="true"
    android:focusable="true"
    android:background="?attr/selectableItemBackgroundBorderless">

    <!-- Circular avatar -->
    <ImageView
        android:id="@+id/artistCardAvatar"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_outline_music_note_24" />
    <!-- Note: CircleCrop transform is applied in the adapter via Glide -->

    <!-- Artist name -->
    <TextView
        android:id="@+id/artistCardName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="?attr/colorOnSurface"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:ellipsize="end"
        android:gravity="center" />

    <!-- Song count -->
    <TextView
        android:id="@+id/artistCardSongs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="8dp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:maxLines="1"
        android:ellipsize="end"
        android:gravity="center" />

</LinearLayout>