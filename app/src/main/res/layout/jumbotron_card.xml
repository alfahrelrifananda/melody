<?xml version="1.0" encoding="utf-8"?>
<!--
    jumbotron_card.xml  –  Melody greeting jumbotron
    ─────────────────────────────────────────────────
    • Pure ambient card — no buttons, no controls
    • 3 blobs animate infinitely (driven by JumbotronHeaderAdapter)
    • Content is centred: app name + time-aware greeting + tagline
    • All colours come from Material You dynamic palette (Android 12+)

    Place at:  res/layout/jumbotron_card.xml
-->

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/jumbotronCard"
    android:layout_width="match_parent"
    android:layout_height="180dp"
    android:layout_marginStart="24dp"
    android:layout_marginEnd="24dp"
    android:layout_marginTop="16dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="32dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <!-- Clip frame — blobs stay within rounded corners -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="true"
        android:clipToPadding="true">

        <!-- Background fill -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/colorSurfaceVariant" />

        <!-- ── BLOB 1 · colorPrimary · large · top-start ── -->
        <View
            android:id="@+id/blob1"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="-80dp"
            android:layout_marginTop="-80dp"
            android:alpha="0.60"
            android:background="@drawable/blob_shape_1" />

        <!-- ── BLOB 2 · colorSecondary · medium · bottom-end ── -->
        <View
            android:id="@+id/blob2"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="-60dp"
            android:layout_marginBottom="-60dp"
            android:alpha="0.55"
            android:background="@drawable/blob_shape_2" />

        <!-- ── BLOB 3 · colorTertiary · small · centre ── -->
        <View
            android:id="@+id/blob3"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center"
            android:layout_marginStart="40dp"
            android:alpha="0.35"
            android:background="@drawable/blob_shape_3" />


        <!-- ─── Centred greeting content ─── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp">

            <!-- App wordmark -->
            <TextView
                android:id="@+id/jumbotronAppName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.20"
                android:text="MELODY"
                android:textAllCaps="true"
                android:textColor="?attr/colorPrimary"
                android:textSize="11sp" />

            <!-- Time-aware greeting — set dynamically in JumbotronHeaderAdapter -->
            <TextView
                android:id="@+id/jumbotronGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="2"
                android:text="Good morning"
                android:textColor="?attr/colorOnSurface"
                android:textSize="28sp"
                android:lineSpacingMultiplier="1.05" />

            <!-- Calm static tagline -->
            <TextView
                android:id="@+id/jumbotronTagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:text="Start listening now"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="14sp" />

        </LinearLayout>

    </FrameLayout>

</com.google.android.material.card.MaterialCardView>