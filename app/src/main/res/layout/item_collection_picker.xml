<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <!-- Cover thumbnail -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="?attr/colorSurfaceVariant"
        android:layout_marginEnd="16dp"
        android:clickable="false"
        android:focusable="false">

        <ImageView
            android:id="@+id/itemCollectionCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:clickable="false"
            android:focusable="false"
            android:contentDescription="Collection cover" />

        <!-- Placeholder when no cover -->
        <LinearLayout
            android:id="@+id/itemCoverPlaceholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:background="?attr/colorSurfaceVariant"
            android:visibility="visible"
            android:clickable="false"
            android:focusable="false">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_outline_music_note_24"
                app:tint="?attr/colorOnSurfaceVariant"
                android:contentDescription="No cover"
                android:clickable="false"
                android:focusable="false" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Name + song count -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:clickable="false"
        android:focusable="false">

        <TextView
            android:id="@+id/itemCollectionName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface"
            android:maxLines="1"
            android:ellipsize="end"
            android:clickable="false"
            android:focusable="false" />

        <TextView
            android:id="@+id/itemCollectionSongCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:maxLines="1"
            android:clickable="false"
            android:focusable="false" />

    </LinearLayout>

    <!-- Checkmark shown when already in this collection -->
    <ImageView
        android:id="@+id/itemCollectionCheck"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_baseline_check_24"
        app:tint="?attr/colorPrimary"
        android:visibility="gone"
        android:contentDescription="Already added"
        android:clickable="false"
        android:focusable="false" />

</LinearLayout>